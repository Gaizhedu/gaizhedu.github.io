# 依赖、缓存与日志
node_modules/
.pnpm-store/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 系统与编辑器文件
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# 本地工作记录与启动脚本（项目说明和测试纳入版本管理）
/task_plan.md
/findings.md
/progress.md
/.planning/
/start-game.cmd

# 素材白名单：仅保留运行时实际加载的文件
/assets/*
!/assets/player/
!/assets/Background/
!/assets/ground/
!/assets/ui/
!/assets/items/

/assets/Background/*
!/assets/Background/bookshelf.png
!/assets/Background/sky_2.png
!/assets/Background/pillar.png

/assets/ground/*
!/assets/ground/single_block.png

/assets/ui/*
!/assets/ui/left.png
!/assets/ui/upper.png
!/assets/ui/right.png

/assets/items/*
!/assets/items/maoxian_blue.png
!/assets/items/maoxian_red.png
!/assets/items/fish_can_[1-6].png
!/assets/items/diamond.png

!/assets/items/chest_head.png
!/assets/items/castle.png
!/assets/items/spring.png
!/assets/items/right.png

/assets/player/*
!/assets/player/cat_player.png
!/assets/player/cat_jump.png

# Photoshop source files are never runtime assets
*.[pP][sS][dD]
